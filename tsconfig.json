{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "*.js",
    "*.ts",
    "packages/**/*.js",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.js",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/dist", "**/*.test.ts", "**/*.spec.ts", ".agent-worktrees"]
}