    "@stellar/stellar-sdk": "^16.0.0",
    "snarkjs": "0.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
