{
  "globalHeaders": {
    "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_expo/*",
      "/assets/*",
      "/*.css",
      "/*.js",
      "/*.json",
      "/*.png",
      "/*.jpg",
      "/*.jpeg",
      "/*.gif",
      "/*.svg",
      "/*.ico",
      "/*.txt"
    ]
  }
}
