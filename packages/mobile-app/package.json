{
  "name": "@nodezero/mobile-app",
  "version": "0.0.1",
  "description": "NodeZero.social Expo / React Native mobile application",
  "license": "MIT",
  "main": "./index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "eslint app src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.7",
    "@nodezero/embedded-wallet": "workspace:*",
    "@nodezero/geo-discovery": "workspace:*",
    "@nodezero/p2p-comms": "workspace:*",
    "@nodezero/solid-pod-sync": "workspace:*",
    "@nodezero/zk-crypto": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.2",
    "expo-location": "~17.0.1",
    "expo-router": "~3.5.14",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.2",
    "react-native-safe-area-context": "4.10.4",
    "react-native-web": "~0.19.10",
    "react-native-screens": "3.31.1",
    "@react-native-community/slider": "^4.5.5",
    "react-native-rss-parser": "^1.5.1",
    "@expo/vector-icons": "^14.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@types/react": "~18.2.79",
    "@types/react-native": "^0.73.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}
