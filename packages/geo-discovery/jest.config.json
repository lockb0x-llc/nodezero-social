{
  "preset": "ts-jest/presets/default-esm",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", {
      "useESM": true,
      "diagnostics": { "ignoreCodes": ["TS151002"] }
    }]
  },
  "testEnvironment": "node",
  "testMatch": ["**/src/**/__tests__/**/*.test.ts"]
}
