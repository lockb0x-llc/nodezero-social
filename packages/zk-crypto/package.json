{
  "name": "@nodezero/zk-crypto",
  "version": "0.0.1",
  "description": "Zero-Knowledge circuits and prover library for NodeZero Proof of Humanity",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./pod-ownership": {
      "import": "./src/pod-ownership-prover.ts",
      "types": "./src/pod-ownership-prover.ts"
    },
    "./pod-claim": {
      "import": "./src/pod-ownership-claim.ts",
      "require": "./src/pod-ownership-claim.ts",
      "types": "./src/pod-ownership-claim.ts"
    },
    "./attestation-cipher": {
      "import": "./src/attestation-cipher.ts",
      "types": "./src/attestation-cipher.ts"
    }
  },
  "scripts": {
    "build:circuits": "node scripts/compile-circuits.mjs",
    "build:setup": "node scripts/trusted-setup.mjs",
    "build:all": "pnpm run build:circuits && pnpm run build:setup",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "clean": "rm -rf build/"
  },
  "dependencies": {
    "blake-hash": "2.0.0",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "ffjavascript": "^0.3.0",
    "snarkjs": "0.7.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.5"
  }
}
