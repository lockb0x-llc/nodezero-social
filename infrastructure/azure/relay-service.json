{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "9406635961915748732"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Deployment location for all resources."
      }
    },
    "environmentName": {
      "type": "string",
      "defaultValue": "staging-testnet",
      "allowedValues": [
        "testnet",
        "staging-testnet",
        "production-mainnet"
      ],
      "metadata": {
        "description": "Short environment identifier."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "nodezero-social",
      "minLength": 3,
      "metadata": {
        "description": "Global application name prefix."
      }
    },
    "appServicePlanName": {
      "type": "string",
      "defaultValue": "asp-nodezero-staging-relay",
      "metadata": {
        "description": "Name of the dedicated App Service Plan for the relay service."
      }
    },
    "appServicePlanSkuName": {
      "type": "string",
      "defaultValue": "B1",
      "metadata": {
        "description": "App Service Plan SKU name."
      }
    },
    "appServicePlanSkuTier": {
      "type": "string",
      "defaultValue": "Basic",
      "metadata": {
        "description": "App Service Plan SKU tier."
      }
    },
    "provisionerBaseUrl": {
      "type": "string",
      "defaultValue": "https://api.nodezero.social",
      "metadata": {
        "description": "Base URL of the NodeZero provisioner API for identity verification."
      }
    },
    "relayPort": {
      "type": "int",
      "defaultValue": 8080,
      "metadata": {
        "description": "Listening port for the relay WebSocket server."
      }
    },
    "appCommandLine": {
      "type": "string",
      "defaultValue": "node dist/index.js",
      "metadata": {
        "description": "Startup command line for the relay Node.js process."
      }
    },
    "linuxFxVersion": {
      "type": "string",
      "defaultValue": "NODE|22-lts",
      "metadata": {
        "description": "Linux runtime stack identifier."
      }
    }
  },
  "variables": {
    "siteName": "[format('{0}-{1}-relay', parameters('appName'), parameters('environmentName'))]",
    "commonTags": {
      "application": "[parameters('appName')]",
      "environment": "[parameters('environmentName')]",
      "component": "relay-service",
      "runtimeBoundary": "[if(equals(parameters('environmentName'), 'production-mainnet'), 'production', 'non-production')]",
      "costGuardrail": "enabled"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[parameters('appServicePlanName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "kind": "linux",
      "sku": {
        "name": "[parameters('appServicePlanSkuName')]",
        "tier": "[parameters('appServicePlanSkuTier')]",
        "size": "[parameters('appServicePlanSkuName')]",
        "family": "B",
        "capacity": 1
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[variables('siteName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "kind": "app,linux",
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "[parameters('linuxFxVersion')]",
          "alwaysOn": true,
          "appCommandLine": "[parameters('appCommandLine')]",
          "healthCheckPath": "/healthz",
          "webSocketsEnabled": true,
          "appSettings": [
            {
              "name": "RELAY_PROVISIONER_URL",
              "value": "[parameters('provisionerBaseUrl')]"
            },
            {
              "name": "RELAY_PORT",
              "value": "[string(parameters('relayPort'))]"
            },
            {
              "name": "WEBSITES_PORT",
              "value": "[string(parameters('relayPort'))]"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "false"
            },
            {
              "name": "ENABLE_ORYX_BUILD",
              "value": "false"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]"
      ]
    }
  ],
  "outputs": {
    "relayAppName": {
      "type": "string",
      "value": "[variables('siteName')]"
    },
    "relayDefaultHostname": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('siteName')), '2022-09-01').defaultHostName]"
    },
    "relayEndpointUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('siteName')), '2022-09-01').defaultHostName)]"
    },
    "relayWebSocketUrl": {
      "type": "string",
      "value": "[format('wss://{0}', reference(resourceId('Microsoft.Web/sites', variables('siteName')), '2022-09-01').defaultHostName)]"
    }
  }
}