FROM node:26-bookworm-slim AS build

WORKDIR /workspace
RUN npm install --global pnpm@11.8.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/solid-pod-sync/package.json packages/solid-pod-sync/tsconfig.json packages/solid-pod-sync/
COPY packages/jss-provisioner/package.json packages/jss-provisioner/tsconfig.json packages/jss-provisioner/
RUN pnpm install --filter @nodezero/jss-provisioner... --frozen-lockfile --ignore-scripts
COPY packages/solid-pod-sync/src packages/solid-pod-sync/src
COPY packages/jss-provisioner/src packages/jss-provisioner/src
RUN pnpm --filter @nodezero/jss-provisioner build

FROM node:26-bookworm-slim
COPY --from=build /workspace /workspace
WORKDIR /workspace/packages/jss-provisioner
COPY deployments/portable/provisioner-entrypoint.sh /usr/local/bin/provisioner-entrypoint.sh
ENV NODE_ENV=production
ENV HOME=/var/lib/nodezero
RUN mkdir -p /var/lib/nodezero
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/provisioner-entrypoint.sh"]