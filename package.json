{
  "name": "nodezero-social",
  "version": "0.2.0-testnet",
  "private": true,
  "description": "NodeZero.social – a decentralized, Web3 social network for the 21st century",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "test:contracts": "node ./scripts/test-contracts.mjs",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\"",
    "policy:validate-env": "bash ./scripts/policy/validate-env-isolation.sh",
    "policy:validate-attestation-fail-closed": "node ./scripts/policy/validate-attestation-fail-closed.mjs",
    "policy:validate-docustream-enabled": "node ./scripts/policy/validate-docustream-enabled.mjs",
    "policy:validate-pwa": "node ./scripts/policy/validate-pwa.mjs",
    "pwa:validate:artifact": "node ./scripts/pwa/validate-pwa-artifact.mjs",
    "qa:smoke": "bash ./scripts/qa/staging-smoke.sh",
    "qa:smoke:solid-bootstrap": "bash ./scripts/qa/staging-solid-bootstrap-policy-smoke.sh",
    "qa:smoke:gate": "bash ./scripts/qa/staging-smoke.sh && bash ./scripts/qa/staging-solid-bootstrap-policy-smoke.sh",
    "qa:smoke:auth": "node ./scripts/qa/staging-auth-evidence.mjs",
    "qa:audit:lockbox": "node ./scripts/qa/lockbox-auditor.mjs",
    "qa:smoke:community-directory": "node ./scripts/qa/staging-community-directory-evidence.mjs",
    "qa:smoke:mashlib-runtime": "bash ./scripts/qa/staging-mashlib-runtime-proof.sh",
    "qa:smoke:mashlib-deployed": "bash ./scripts/qa/staging-mashlib-deployed-proof.sh",
    "qa:smoke:docustream-pane": "node ./scripts/qa/staging-docustream-pane-evidence.mjs",
    "qa:device:cloud": "node ./scripts/qa/run-device-cloud.mjs",
    "qa:device:validate": "node ./scripts/qa/validate-device-evidence.mjs",
    "test:device-evidence": "node --test ./scripts/qa/validate-device-evidence.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "pm:dispatch": "pwsh -NoProfile -File ./scripts/agents/dispatch-parallel.ps1",
    "pm:dispatch:dry": "pwsh -NoProfile -File ./scripts/agents/dispatch-parallel.ps1 -DryRun",
    "pm:status": "pwsh -NoProfile -File ./scripts/agents/status.ps1",
    "pm:followup": "pwsh -NoProfile -File ./scripts/agents/status.ps1 -FollowUp",
    "pm:followup:dry": "pwsh -NoProfile -File ./scripts/agents/status.ps1 -FollowUp -DryRun",
    "pm:loop": "pwsh -NoProfile -File ./scripts/agents/status.ps1 -Loop -FollowUp",
    "pm:loop:dry": "pwsh -NoProfile -File ./scripts/agents/status.ps1 -Loop -FollowUp -DryRun -MaxIterations 1 -LoopIntervalMinutes 0",
    "pm:reintegrate": "pwsh -NoProfile -File ./scripts/agents/reintegrate-parallel.ps1",
    "pm:reintegrate:dry": "pwsh -NoProfile -File ./scripts/agents/reintegrate-parallel.ps1 -DryRun",
    "prepare:zk:testnet": "bash ./scripts/zk/prepare-testnet.sh",
    "prepare:zk:test-artifacts": "node ./scripts/zk/fetch-test-artifacts.mjs",
    "prepare:checksums:testnet": "bash ./scripts/stellar/artifact-checksums.sh generate",
    "verify:checksums:testnet": "bash ./scripts/stellar/artifact-checksums.sh verify",
    "provisioner:dev": "pnpm --filter @nodezero/jss-provisioner dev",
    "provisioner:type-check": "pnpm --filter @nodezero/jss-provisioner type-check",
    "relay:dev": "pnpm --filter @nodezero/relay-service dev",
    "relay:build": "pnpm --filter @nodezero/relay-service build",
    "waku:spike:up": "docker compose -f ./scripts/waku-spike/docker-compose.yml up -d",
    "waku:spike:down": "docker compose -f ./scripts/waku-spike/docker-compose.yml down",
    "waku:spike": "node ./packages/waku-comms/spike/local-spike.mjs",
    "deploy:stellar:testnet": "bash ./scripts/stellar/deploy-testnet.sh",
    "deploy:azure": "bash ./scripts/azure/deploy.sh",
    "deploy:azure:notifications": "bash ./scripts/azure/deploy-notification-infra.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@stellar/stellar-sdk": "^16.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.4"
  }
}
