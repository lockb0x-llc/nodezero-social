{
  "name": "nodezero-social",
  "version": "0.0.1",
  "private": true,
  "description": "NodeZero.social – a decentralized, Web3 social network for the 21st century",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "prepare:zk:testnet": "bash ./scripts/zk/prepare-testnet.sh",
    "deploy:stellar:testnet": "bash ./scripts/stellar/deploy-testnet.sh",
    "deploy:azure": "bash ./scripts/azure/deploy.sh"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2"
  }
}
